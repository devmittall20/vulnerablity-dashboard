generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("MEMBER")
  created_at    DateTime @default(now())

  scans         Scan[]
  assignments   AssetVulnerability[]
  history       RemediationHistory[]
  reports       Report[]
}

model Asset {
  id          String   @id @default(uuid())
  hostname    String
  ip_address  String
  os          String?
  criticality String   @default("Medium") // Low, Medium, High, Critical
  exposure    String   @default("Internal") // Internal, External
  created_at  DateTime @default(now())

  vulnerabilities AssetVulnerability[]
}

model Scan {
  id           String   @id @default(uuid())
  scanner_name String
  scan_date    DateTime @default(now())
  imported_by  String
  created_at   DateTime @default(now())

  user         User     @relation(fields: [imported_by], references: [id])
  vulnerabilities AssetVulnerability[]
}

model Vulnerability {
  id                String   @id @default(uuid())
  cve_id            String?
  title             String
  description       String
  severity          String // Low, Medium, High, Critical
  cvss_score        Float?
  remediation_steps String?
  tags              String? // E.g., "PCI-DSS, ISO-27001"

  assets            AssetVulnerability[]
}

model AssetVulnerability {
  id               String   @id @default(uuid())
  asset_id         String
  vulnerability_id String
  scan_id          String
  status           String   @default("Open") // Open, In Progress, Resolved, Risk Accepted
  assigned_to      String?
  due_date         DateTime?
  risk_score       Float    @default(0.0)

  asset         Asset         @relation(fields: [asset_id], references: [id])
  vulnerability Vulnerability @relation(fields: [vulnerability_id], references: [id])
  scan          Scan          @relation(fields: [scan_id], references: [id])
  user          User?         @relation(fields: [assigned_to], references: [id])

  history       RemediationHistory[]
}

model RemediationHistory {
  id             String   @id @default(uuid())
  asset_vuln_id  String
  changed_by     String
  old_status     String
  new_status     String
  notes          String?
  created_at     DateTime @default(now())

  assetVuln      AssetVulnerability @relation(fields: [asset_vuln_id], references: [id])
  user           User               @relation(fields: [changed_by], references: [id])
}

model Report {
  id           String   @id @default(uuid())
  generated_by String
  report_type  String
  file_url     String
  created_at   DateTime @default(now())

  user         User     @relation(fields: [generated_by], references: [id])
}
